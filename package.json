{
  "name": "@moubing/bing-ui",
  "version": "0.19.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/bing-ui.css"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts --passWithNoTests",
    "test:visual": "playwright test",
    "storybook": "node scripts/storybook-dev.mjs",
    "build-storybook": "cross-env STORYBOOK=true storybook build",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@lucide/vue": "^1.61.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "gsap": "^3.15.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7",
    "vue": "^3.5.35",
    "vue-tsc": "^3.2.8",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/vue": "^0.5.0",
    "dayjs": "^1.11.21",
    "pinyin-pro": "^3.29.5",
    "shiki": "^4.2.0"
  }
}
